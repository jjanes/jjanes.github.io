/* ===================================================
   DREZDIN THEME — johnjanes.com
   Light only. White base. Blue accents. Clean.
   =================================================== */

:root {
  color-scheme: light;

  --white:      #ffffff;
  --bg:         #ffffff;
  --bg-subtle:  #eef1f6;
  --border:     #c8d3de;
  --border-blue:#93c5fd;

  --text:       #0d1117;
  --text-2:     #3d4a5c;
  --text-3:     #6b7a90;

  --blue:       #2563eb;
  --blue-dark:  #1d4ed8;
  --blue-faint: #eff6ff;
  --blue-tag:   #dbeafe;
  --blue-tag-t: #1e40af;

  --green-bg:   #f0fdf4;
  --green-text: #15803d;
  --yellow-bg:  #fefce8;
  --yellow-text:#854d0e;

  --radius:     6px;
  --radius-lg:  10px;
  --shadow-sm:  0 1px 3px rgba(15,23,42,.06);
  --shadow:     0 4px 16px rgba(15,23,42,.08);

  --max-w:      1180px;
  --nav-h:      60px;
  --font:       -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-brand: "Space Grotesk", -apple-system, BlinkMacSystemFont, sans-serif;
  --mono:       "JetBrains Mono", "Fira Code", ui-monospace, Consolas, monospace;
}

/* ── Reset ─────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 16px; scroll-behavior: smooth; background: #fff; }

body {
  font-family: var(--font);
  background: var(--white);
  color: var(--text);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; height: auto; display: block; }
a   { color: var(--blue); text-decoration: none; transition: color .15s; }
a:hover { color: var(--blue-dark); }
h1, h2, h3, h4 { font-family: var(--font-brand); font-weight: 700; line-height: 1.25; color: var(--text); }

/* ── Nav ────────────────────────────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--white);
  border-bottom: 1px solid var(--border);
  height: var(--nav-h);
}

.nav-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 1.5rem;
  height: var(--nav-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  position: relative;
}

.nav-logo {
  font-family: var(--font-brand);
  font-size: 1.15rem;
  font-weight: 800;
  color: var(--blue);
  letter-spacing: -.03em;
  flex-shrink: 0;
}
.nav-logo:hover { color: var(--blue-dark); }

.nav-links {
  display: flex;
  align-items: center;
  gap: .1rem;
  list-style: none;
}

.nav-links a {
  display: block;
  padding: .35rem .7rem;
  border-radius: var(--radius);
  color: var(--text-2);
  font-size: .875rem;
  font-weight: 500;
}
.nav-links a:hover,
.nav-links a.active {
  color: var(--blue);
  background: var(--blue-faint);
}

.nav-icon-link {
  display: flex;
  align-items: center;
  padding: .35rem;
  color: var(--text-3);
  border-radius: var(--radius);
}
.nav-icon-link:hover { color: var(--blue); background: var(--blue-faint); }

.nav-toggle {
  display: none;
  flex-direction: column;
  gap: 4px;
  background: none;
  border: none;
  cursor: pointer;
  padding: .5rem;
}
.nav-toggle span {
  display: block;
  width: 20px;
  height: 2px;
  background: var(--text);
  border-radius: 2px;
}

/* ── Live banner ────────────────────────────────────────────────────────── */
.live-banner {
  background: var(--blue);
  color: #fff;
  padding: .6rem 1.5rem;
  text-align: center;
  font-size: .875rem;
  font-weight: 500;
}
.live-banner a { color: #fff; font-weight: 700; text-decoration: underline; }

.live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: #fca5a5;
  border-radius: 50%;
  margin-right: .5rem;
  animation: blink 1.4s ease infinite;
}
@keyframes blink {
  0%,100% { opacity:1; } 50% { opacity:.3; }
}

/* ── Layout ─────────────────────────────────────────────────────────────── */
.site-main { flex: 1; }

.container {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* ── Hero ───────────────────────────────────────────────────────────────── */
.hero {
  padding: 4rem 0 3.5rem;
  border-bottom: 1px solid var(--border);
}
.hero-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 1.5rem;
  display: flex;
  align-items: center;
  gap: 2.5rem;
}
.hero-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  border: 2px solid var(--border);
  object-fit: cover;
  flex-shrink: 0;
}
.hero-name {
  font-size: 2.4rem;
  letter-spacing: -.04em;
  margin-bottom: .35rem;
}
.hero-name span { color: var(--blue); }
.hero-tagline {
  color: var(--text-2);
  font-size: 1rem;
  margin-bottom: 1.1rem;
  max-width: 540px;
}
.hero-social {
  display: flex;
  gap: .45rem;
  flex-wrap: wrap;
}
.hero-social a {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .28rem .65rem;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text-2);
  font-size: .78rem;
  font-weight: 500;
  background: var(--white);
}
.hero-social a:hover {
  border-color: var(--blue);
  color: var(--blue);
  background: var(--blue-faint);
}

/* ── Home sections ──────────────────────────────────────────────────────── */
.home-section {
  padding: 3rem 0;
  border-bottom: 1px solid var(--border);
}
.home-section:last-of-type { border-bottom: none; }

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1.75rem;
}
.section-title {
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: -.01em;
}
.section-link {
  font-size: .8rem;
  color: var(--blue);
  font-weight: 600;
}

/* ── Announcement ───────────────────────────────────────────────────────── */
.announcement-section {
  padding: 2.25rem 0;
  border-bottom: 1px solid var(--border);
  background: var(--bg-subtle);
}

.announcement-card {
  display: flex;
  align-items: center;
  gap: 2.5rem;
  border: 1px solid var(--border-blue);
  border-radius: var(--radius-lg);
  background: var(--white);
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(37,99,235,.08);
}

.announcement-body {
  flex: 1;
  padding: 2rem 2rem 2rem 2.25rem;
  display: flex;
  flex-direction: column;
  gap: .75rem;
}

.announcement-label {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .7rem;
  font-family: var(--mono);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--blue);
  background: var(--blue-tag);
  padding: .2rem .6rem;
  border-radius: 3px;
  width: fit-content;
}

.announcement-title {
  font-size: 1.6rem;
  letter-spacing: -.03em;
  line-height: 1.2;
}
.announcement-title a { color: inherit; }
.announcement-title a:hover { color: var(--blue); }

.announcement-summary {
  font-size: .95rem;
  color: var(--text-2);
  line-height: 1.65;
  max-width: 560px;
}

.announcement-footer {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: .25rem;
}

.announcement-date {
  font-size: .78rem;
  font-family: var(--mono);
  color: var(--text-3);
}

.announcement-img-wrap {
  flex-shrink: 0;
  width: 380px;
  display: block;
  overflow: hidden;
}
.announcement-img-wrap img {
  width: 100%;
  height: 240px;
  object-fit: cover;
  display: block;
  transition: transform .3s;
}
.announcement-img-wrap:hover img { transform: scale(1.02); }

@media (max-width: 900px) {
  .announcement-card { flex-direction: column; }
  .announcement-img-wrap { width: 100%; }
  .announcement-img-wrap img { height: 200px; }
  .announcement-body { padding: 1.5rem; }
  .announcement-title { font-size: 1.35rem; }
}

/* ── Prose video shortcode ──────────────────────────────────────────────── */
.prose-video {
  margin: 1.5rem 0;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  background: #000;
}
.prose-video video {
  width: 100%;
  display: block;
  max-height: 480px;
  object-fit: contain;
}

/* ── Post/project grids ─────────────────────────────────────────────────── */
.card-grid   { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
.card-grid-4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }

.post-card-date {
  font-size: .75rem;
  color: var(--text-3);
  font-family: var(--mono);
}
.post-card-title {
  font-size: 1rem;
  font-weight: 700;
  line-height: 1.4;
}
.post-card-title a { color: inherit; }
.post-card-title a:hover { color: var(--blue); }

.post-card-summary {
  font-size: .85rem;
  color: var(--text-2);
  line-height: 1.65;
  flex: 1;
}

.badge-featured {
  display: inline-block;
  font-size: .65rem;
  font-weight: 700;
  background: var(--blue);
  color: #fff;
  padding: .12rem .45rem;
  border-radius: 3px;
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-left: .5rem;
  vertical-align: middle;
}

/* ── Tags ───────────────────────────────────────────────────────────────── */
.tag-row { display: flex; flex-wrap: wrap; gap: .35rem; }

.tag {
  font-size: .7rem;
  font-family: var(--mono);
  color: var(--text-3);
  border: 1px solid var(--border);
  padding: .15rem .45rem;
  border-radius: 3px;
  background: var(--white);
}

.tag-blue {
  background: var(--blue-tag);
  color: var(--blue-tag-t);
  border-color: transparent;
}

/* ── YouTube grid + cards ───────────────────────────────────────────────── */
.yt-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; }
.yt-card {
  display: block;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: border-color .15s, box-shadow .15s;
}
.yt-card:hover {
  border-color: var(--blue);
  box-shadow: var(--shadow);
}
.yt-thumb {
  position: relative;
  padding-top: 56.25%;
  background: var(--bg-subtle);
  overflow: hidden;
}
.yt-thumb img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.yt-play-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity .2s;
}
.yt-card:hover .yt-play-overlay { opacity: 1; }
.yt-play-overlay svg { filter: drop-shadow(0 2px 6px rgba(0,0,0,.5)); }
.yt-info { padding: .7rem .85rem .85rem; }
.yt-title {
  font-size: .8rem;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ── Tech stack ─────────────────────────────────────────────────────────── */
.tech-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.tech-category {
  background: var(--bg-subtle);
  padding: 1.1rem 1.25rem;
}
.tech-cat-label {
  font-size: .65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--text-3);
  font-family: var(--mono);
  margin-bottom: .7rem;
}
.tech-items { display: flex; flex-wrap: wrap; gap: .4rem; }
.tech-pill {
  display: flex;
  align-items: center;
  gap: .3rem;
  padding: .25rem .55rem;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: .78rem;
  font-weight: 500;
  color: var(--text);
  background: var(--white);
}
.tech-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ── Project rows (homepage) ────────────────────────────────────────────── */
.projects-list {
  display: flex;
  flex-direction: column;
}

.project-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2rem;
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--border);
}
.project-row:first-child { border-top: 1px solid var(--border); }

.project-row-main { flex: 1; display: flex; flex-direction: column; gap: .5rem; }

.project-row-header {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-wrap: wrap;
}

.project-row-title { font-size: 1rem; font-weight: 700; }
.project-row-title a { color: inherit; }
.project-row-title a:hover { color: var(--blue); }

.project-row-summary { font-size: .875rem; color: var(--text-2); line-height: 1.6; max-width: 680px; }

.project-row-links { display: flex; gap: .5rem; flex-shrink: 0; align-items: center; }

/* ── Project cards (list page) ──────────────────────────────────────────── */
.project-card {
  background: var(--bg-subtle);
  padding: 1.5rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  gap: .65rem;
  transition: border-color .15s, box-shadow .15s;
}
.project-card:hover { border-color: var(--blue); box-shadow: 0 2px 12px rgba(37,99,235,.08); }

.card-grid-2 { display: grid; grid-template-columns: repeat(2,1fr); gap: 1rem; }

.project-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: .75rem;
}
.project-card-title { font-size: 1.05rem; font-weight: 700; }
.project-card-title a { color: inherit; }
.project-card-title a:hover { color: var(--blue); }

.status-badge {
  display: inline-flex;
  align-items: center;
  font-size: .65rem;
  font-family: var(--mono);
  font-weight: 700;
  padding: .15rem .5rem;
  border-radius: 3px;
  white-space: nowrap;
  flex-shrink: 0;
}
.status-active   { background: var(--green-bg);  color: var(--green-text); }
.status-wip      { background: var(--yellow-bg);  color: var(--yellow-text); }
.status-archived { background: var(--bg-subtle);  color: var(--text-3); }

.project-card-summary {
  font-size: .875rem;
  color: var(--text-2);
  line-height: 1.65;
  flex: 1;
}

.project-card-footer {
  display: flex;
  align-items: center;
  gap: .5rem;
  padding-top: .85rem;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
}

/* ── Buttons ────────────────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .4rem .85rem;
  border-radius: var(--radius);
  font-size: .8rem;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all .15s;
  line-height: 1;
}
.btn-sm { padding: .3rem .6rem; font-size: .75rem; }
.btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
.btn-primary:hover { background: var(--blue-dark); border-color: var(--blue-dark); color: #fff; }
.btn-outline { border-color: var(--border); color: var(--text-2); background: var(--white); }
.btn-outline:hover { border-color: var(--blue); color: var(--blue); background: var(--blue-faint); }

/* ── Project single hero ────────────────────────────────────────────────── */
.project-hero {
  padding: 3rem 0 2.5rem;
  border-bottom: 1px solid var(--border);
}
.project-hero-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 1.5rem;
}
.project-back {
  display: inline-flex;
  align-items: center;
  gap: .25rem;
  font-size: .78rem;
  color: var(--text-3);
  font-family: var(--mono);
  margin-bottom: 1.25rem;
}
.project-back:hover { color: var(--blue); }
.project-title {
  font-size: 2.4rem;
  letter-spacing: -.04em;
  margin-bottom: .75rem;
}
.project-summary-text {
  font-size: 1.05rem;
  color: var(--text-2);
  max-width: 660px;
  line-height: 1.7;
  margin-bottom: 1.25rem;
}
.project-meta-row {
  display: flex;
  align-items: center;
  gap: .85rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}
.project-links { display: flex; gap: .6rem; flex-wrap: wrap; }

/* ── Media gallery ──────────────────────────────────────────────────────── */
.media-gallery {
  padding: 2.5rem 0;
  border-bottom: 1px solid var(--border);
}
.media-gallery > h2 {
  max-width: var(--max-w);
  margin: 0 auto 1.5rem;
  padding: 0 1.5rem;
  font-size: 1.1rem;
  font-weight: 700;
}
.media-items {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}
.media-item {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.media-item-media { background: #000; }
.media-item video {
  width: 100%;
  display: block;
  max-height: 540px;
  object-fit: contain;
}
.media-item-media img { width: 100%; display: block; }
.media-item-yt { position: relative; padding-top: 56.25%; }
.media-item-yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }
.media-caption {
  padding: .9rem 1.15rem 1rem;
  font-size: .9rem;
  color: var(--text-2);
  line-height: 1.65;
  border-top: 1px solid var(--border);
  background: var(--white);
}

/* ── Prose layout ───────────────────────────────────────────────────────── */
.prose-layout {
  max-width: 760px;
  margin: 0 auto;
  padding: 3rem 1.5rem;
}
.prose-header {
  margin-bottom: 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
}
.prose-title {
  font-size: 2.1rem;
  letter-spacing: -.04em;
  margin-bottom: .65rem;
}
.prose-meta {
  display: flex;
  align-items: center;
  gap: .75rem;
  flex-wrap: wrap;
  font-size: .78rem;
  color: var(--text-3);
  font-family: var(--mono);
}
.prose-body { font-size: 1rem; line-height: 1.8; color: var(--text); }
.prose-body h2 {
  font-size: 1.4rem;
  margin: 2.5rem 0 .9rem;
  padding-bottom: .5rem;
  border-bottom: 1px solid var(--border);
}
.prose-body h3 { font-size: 1.15rem; margin: 2rem 0 .65rem; }
.prose-body p  { margin-bottom: 1.2rem; }
.prose-body ul,
.prose-body ol { margin-bottom: 1.2rem; padding-left: 1.5rem; }
.prose-body li { margin-bottom: .4rem; }
.prose-body a  { color: var(--blue); }
.prose-body a:hover { color: var(--blue-dark); text-decoration: underline; }
.prose-body blockquote {
  border-left: 3px solid var(--blue);
  padding: .7rem 1.15rem;
  margin: 1.5rem 0;
  background: var(--blue-faint);
  border-radius: 0 var(--radius) var(--radius) 0;
  color: var(--text-2);
  font-style: italic;
}
.prose-body code {
  font-family: var(--mono);
  font-size: .875em;
  background: var(--bg-subtle);
  padding: .15em .4em;
  border-radius: 3px;
  color: var(--blue-dark);
  border: 1px solid var(--border);
}
.prose-body pre {
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.15rem;
  overflow-x: auto;
  margin-bottom: 1.2rem;
}
.prose-body pre code { background: none; border: none; padding: 0; font-size: .875rem; color: var(--text); }
.prose-body img { border-radius: var(--radius); margin: 1.5rem 0; border: 1px solid var(--border); }
.prose-body table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; font-size: .9rem; }
.prose-body th { background: var(--bg-subtle); padding: .55rem .8rem; text-align: left; font-weight: 600; border-bottom: 2px solid var(--border); }
.prose-body td { padding: .55rem .8rem; border-bottom: 1px solid var(--border); }

/* ── List page ──────────────────────────────────────────────────────────── */
.list-layout {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 3rem 1.5rem;
}
.list-header { margin-bottom: 2.5rem; }
.list-page-title { font-size: 1.9rem; letter-spacing: -.03em; }
.list-page-desc { color: var(--text-2); margin-top: .4rem; font-size: .95rem; }

.post-list { display: flex; flex-direction: column; }
.post-list-item {
  display: grid;
  grid-template-columns: 96px 1fr auto;
  align-items: baseline;
  gap: 1.5rem;
  padding: .85rem 0;
  border-bottom: 1px solid var(--border);
}
.post-list-date { font-size: .75rem; font-family: var(--mono); color: var(--text-3); white-space: nowrap; }
.post-list-title { font-size: .95rem; font-weight: 600; color: var(--text); }
.post-list-title a { color: inherit; }
.post-list-title a:hover { color: var(--blue); }
.post-list-tags { display: flex; gap: .3rem; }

/* ── Footer ─────────────────────────────────────────────────────────────── */
.site-footer {
  border-top: 1px solid var(--border);
  padding: 1.5rem 0;
  background: var(--white);
}
.footer-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: .75rem;
}
.footer-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
.footer-links a { font-size: .83rem; color: var(--text-3); }
.footer-links a:hover { color: var(--blue); }
.footer-copy { font-size: .75rem; color: var(--text-3); font-family: var(--mono); }

/* ── Misc ───────────────────────────────────────────────────────────────── */
.divider { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }

/* ── Responsive ─────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .card-grid-4 { grid-template-columns: repeat(2,1fr); }
  .card-grid-2 { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .nav-toggle { display: flex; }
  .nav-links {
    display: none;
    position: absolute;
    top: var(--nav-h);
    left: 0; right: 0;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    padding: .6rem;
    box-shadow: var(--shadow);
  }
  .nav-links.open { display: flex; }
  .nav-links a { padding: .55rem 1rem; width: 100%; }

  .hero-inner  { flex-direction: column; text-align: center; gap: 1.25rem; }
  .hero-name   { font-size: 2rem; }
  .hero-social { justify-content: center; }

  .card-grid-4 { grid-template-columns: repeat(2,1fr); }
  .project-row { flex-direction: column; gap: .75rem; }
  .project-row-links { flex-direction: row; }

  .project-title { font-size: 2rem; }
  .prose-title   { font-size: 1.7rem; }
  .section-header { flex-wrap: wrap; gap: .5rem; }
  .post-list-item { grid-template-columns: 82px 1fr; }
  .post-list-tags { display: none; }
  .footer-inner { flex-direction: column; text-align: center; }
}

@media (max-width: 480px) {
  .card-grid-4 { grid-template-columns: 1fr; }
  .post-list-item { grid-template-columns: 1fr; gap: .15rem; }
}
